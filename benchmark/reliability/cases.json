  {
    "id": "P03",
    "project": "config-kit",
    "name": "retryDelay",
    "prompt": "Given {attempt, baseMs, capMs}, return min(capMs, baseMs * 2**attempt). All three inputs must be finite nonnegative safe integers, otherwise return null. Exponent overflow still returns the finite cap; a zero base always returns zero.",
    "reference": "export function retryDelay({attempt,baseMs,capMs}) { if(![attempt,baseMs,capMs].every(n=>Number.isSafeInteger(n)&&n>=0))return null;if(baseMs===0)return 0;return Math.min(capMs,baseMs*2**attempt); }",
    "baseline": "export function retryDelay(...args) { throw new Error(\"Not implemented\"); }",
    "mutants": [
      {
        "name": "boundary-or-contract-regression",
        "source": "export function retryDelay({attempt,baseMs,capMs}) { return baseMs*2**attempt; }"
      }
    ],
    "checks": [
