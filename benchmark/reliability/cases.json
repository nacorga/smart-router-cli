[
  {
    "id": "Q01",
    "project": "queue-kit",
    "name": "insertByPriority",
    "prompt": "Insert a job into a descending numeric priority queue. Equal priorities retain arrival order, including the new job last. Return a new array and preserve all job fields.",
    "reference": "export function insertByPriority(queue, job) { return [...queue, job].sort((a,b)=>b.priority-a.priority); }",
    "baseline": "export function insertByPriority(...args) { throw new Error(\"Not implemented\"); }",
    "mutants": [
      {
        "name": "boundary-or-contract-regression",
        "source": "export function insertByPriority(queue, job) { return [job, ...queue].sort((a,b)=>b.priority-a.priority); }"
      }
    ],
    "checks": [
      {
        "args": [
          [],
          {
            "id": "a",
            "priority": 0
          }
        ],
        "expected": [
          {
            "id": "a",
            "priority": 0
          }
        ]
      },
      {
        "args": [
          [
            {
              "id": "a",
              "priority": 2
            },
            {
              "id": "b",
              "priority": 1
            }
          ],
          {
            "id": "c",
            "priority": 2
          }
        ],
        "expected": [
          {
            "id": "a",
            "priority": 2
          },
          {
            "id": "c",
            "priority": 2
          },
          {
            "id": "b",
            "priority": 1
          }
        ]
      },
      {
        "args": [
          [
            {
              "id": "a",
              "priority": -2
            }
          ],
          {
            "id": "b",
            "priority": -1,
            "data": {
              "x": 1
            }
          }
        ],
        "expected": [
          {
            "id": "b",
            "priority": -1,
            "data": {
              "x": 1
            }
          },
          {
            "id": "a",
            "priority": -2
          }
        ]
      }
    ]
  },
  {
    "id": "Q02",
    "project": "queue-kit",
    "name": "dequeueReady",
    "prompt": "Return {job, remaining} for the first queue entry whose readyAt is at most now. Keep the other entries in order. If none is ready, job is null. Do not mutate inputs.",
    "reference": "export function dequeueReady(queue, now) { const i=queue.findIndex(j=>j.readyAt<=now); return {job:i<0?null:queue[i], remaining:queue.filter((_,n)=>n!==i)}; }",
    "baseline": "export function dequeueReady(...args) { throw new Error(\"Not implemented\"); }",
    "mutants": [
      {
        "name": "boundary-or-contract-regression",
        "source": "export function dequeueReady(queue, now) { const i=queue.findIndex(j=>j.readyAt<now); return {job:i<0?null:queue[i],remaining:queue.filter((_,n)=>n!==i)}; }"
      }
    ],
    "checks": [
      {
        "args": [
          [
            {
              "id": "a",
              "readyAt": 9
            },
            {
              "id": "b",
              "readyAt": 5
            }
          ],
          5
        ],
        "expected": {
          "job": {
            "id": "b",
            "readyAt": 5
          },
          "remaining": [
            {
              "id": "a",
              "readyAt": 9
            }
          ]
        }
      },
      {
        "args": [
          [],
          10
        ],
        "expected": {
          "job": null,
          "remaining": []
        }
      },
      {
        "args": [
          [
            {
              "id": "x",
              "readyAt": 11
            }
          ],
          10
        ],
        "expected": {
          "job": null,
          "remaining": [
            {
              "id": "x",
              "readyAt": 11
            }
          ]
        }
      },
      {
        "args": [
          [
            {
              "id": "a",
              "readyAt": 1
            },
            {
              "id": "b",
              "readyAt": 2
            }
          ],
          10
        ],
        "expected": {
          "job": {
            "id": "a",
            "readyAt": 1
          },
          "remaining": [
            {
              "id": "b",
              "readyAt": 2
            }
          ]
        }
      }
    ]
  },
  {
    "id": "Q03",
    "project": "queue-kit",
    "name": "takeBatch",
    "prompt": "Return {batch, remaining} taking at most limit entries from the front. A non-integer or negative limit throws RangeError. Preserve inputs.",
    "reference": "export function takeBatch(queue, limit) { if(!Number.isInteger(limit)||limit<0)throw new RangeError(); return {batch:queue.slice(0,limit),remaining:queue.slice(limit)}; }",
    "baseline": "export function takeBatch(...args) { throw new Error(\"Not implemented\"); }",
    "mutants": [
      {
        "name": "boundary-or-contract-regression",
        "source": "export function takeBatch(queue, limit) { return {batch:queue.splice(0,limit),remaining:queue}; }"
      }
    ],
    "checks": [
      {
        "args": [
          [
            1,
            2,
            3
          ],
          2
        ],
        "expected": {
          "batch": [
            1,
            2
          ],
          "remaining": [
            3
          ]
        }
      },
      {
        "args": [
          [
            1
          ],
          0
        ],
        "expected": {
          "batch": [],
          "remaining": [
            1
          ]
        }
      },
      {
        "args": [
          [
            1
          ],
          9
        ],
        "expected": {
          "batch": [
            1
          ],
          "remaining": []
        }
      },
      {
        "args": [
          [],
          2
        ],
        "expected": {
          "batch": [],
          "remaining": []
        }
      },
      {
        "args": [
          [
            1
          ],
          -1
        ],
        "throws": "RangeError"
      },
      {
        "args": [
          [
            1
          ],
          1.5
        ],
        "throws": "RangeError"
      }
    ]
  },
  {
    "id": "Q04",
    "project": "queue-kit",
    "name": "dedupeJobs",
    "prompt": "For duplicate string job IDs, keep the last value while ordering IDs by their first appearance. IDs such as __proto__ must work. Return a new array without mutation.",
    "reference": "export function dedupeJobs(jobs) { const m=new Map();for(const job of jobs)m.set(job.id,job);return [...m.values()]; }",
    "baseline": "export function dedupeJobs(...args) { throw new Error(\"Not implemented\"); }",
    "mutants": [
      {
        "name": "boundary-or-contract-regression",
        "source": "export function dedupeJobs(jobs) { const m=new Map();for(const job of jobs)if(!m.has(job.id))m.set(job.id,job);return [...m.values()]; }"
      }
    ],
    "checks": [
      {
        "args": [
          [
            {
              "id": "a",
              "v": 1
            },
            {
              "id": "b",
              "v": 2
            },
            {
              "id": "a",
              "v": 3
            }
          ]
        ],
        "expected": [
          {
            "id": "a",
            "v": 3
          },
          {
            "id": "b",
            "v": 2
          }
        ]
      },
      {
        "args": [
          []
        ],
        "expected": []
      },
      {
        "args": [
          [
            {
              "id": "__proto__",
              "v": 1
            },
            {
              "id": "x",
              "v": 2
            },
            {
              "id": "__proto__",
              "v": 3
            }
          ]
        ],
        "expected": [
          {
            "id": "__proto__",
            "v": 3
          },
          {
            "id": "x",
            "v": 2
          }
        ]
      }
    ]
  },
  {
    "id": "C01",
    "project": "cache-kit",
    "name": "isFresh",
    "prompt": "A cache entry {value, expiresAt} is fresh only when it exists and expiresAt is strictly greater than now. Null is absent. Zero and false values are valid cached values.",
    "reference": "export function isFresh(entry, now) { return entry!==null && entry!==undefined && entry.expiresAt>now; }",
    "baseline": "export function isFresh(...args) { throw new Error(\"Not implemented\"); }",
    "mutants": [
      {
        "name": "boundary-or-contract-regression",
        "source": "export function isFresh(entry, now) { return !!entry && entry.expiresAt>=now; }"
      }
    ],
    "checks": [
      {
        "args": [
          {
            "value": 0,
            "expiresAt": 11
          },
          10
        ],
        "expected": true
      },
      {
        "args": [
          {
            "value": false,
            "expiresAt": 10
          },
          10
        ],
        "expected": false
      },
      {
        "args": [
          null,
          0
        ],
        "expected": false
      },
      {
        "args": [
          {
            "value": false,
            "expiresAt": 1
          },
          0
        ],
        "expected": true
      },
      {
        "args": [
          {
            "value": "x",
            "expiresAt": -1
          },
          0
        ],
        "expected": false
      }
    ]
  },
  {
    "id": "C02",
    "project": "cache-kit",
    "name": "evictLRU",
    "prompt": "Return at most capacity cache entries, evicting the smallest lastUsed first; equal timestamps evict earlier input entries first. Preserve survivor input order and inputs. capacity is a nonnegative integer.",
    "reference": "export function evictLRU(entries, capacity) { const victims=new Set(entries.map((e,i)=>({i,t:e.lastUsed})).sort((a,b)=>a.t-b.t||a.i-b.i).slice(0,Math.max(0,entries.length-capacity)).map(e=>e.i));return entries.filter((_,i)=>!victims.has(i)); }",
    "baseline": "export function evictLRU(...args) { throw new Error(\"Not implemented\"); }",
    "mutants": [
      {
        "name": "boundary-or-contract-regression",
        "source": "export function evictLRU(entries, capacity) { return entries.slice(-capacity); }"
      }
    ],
    "checks": [
      {
        "args": [
          [
            {
              "id": "a",
              "lastUsed": 3
            },
            {
              "id": "b",
              "lastUsed": 1
            },
            {
              "id": "c",
              "lastUsed": 2
            }
          ],
          2
        ],
        "expected": [
          {
            "id": "a",
            "lastUsed": 3
          },
          {
            "id": "c",
            "lastUsed": 2
          }
        ]
      },
      {
        "args": [
          [
            {
              "id": "a",
              "lastUsed": 1
            },
            {
              "id": "b",
              "lastUsed": 1
            }
          ],
          1
        ],
        "expected": [
          {
            "id": "b",
            "lastUsed": 1
          }
        ]
      },
      {
        "args": [
          [
            {
              "id": "a",
              "lastUsed": 1
            }
          ],
          0
        ],
        "expected": []
      },
      {
        "args": [
          [],
          3
        ],
        "expected": []
      },
      {
        "args": [
          [
            {
              "id": "a",
              "lastUsed": 0
            }
          ],
          2
        ],
        "expected": [
          {
            "id": "a",
            "lastUsed": 0
          }
        ]
      }
    ]
  },
