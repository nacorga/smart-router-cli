    "name": "parseDuration",
    "prompt": "Parse a full ASCII nonnegative integer followed by ms, s, m or h to safe integer milliseconds. No whitespace, decimal, signs or trailing characters. Return null for other types, invalid syntax or unsafe results. Leading zeroes are allowed.",
    "reference": "export function parseDuration(value) { if(typeof value!==\"string\")return null;const m=/^([0-9]+)(ms|s|m|h)$/.exec(value);if(!m||m[0]!==value)return null;const n=Number(m[1])*({ms:1,s:1000,m:60000,h:3600000}[m[2]]);return Number.isSafeInteger(n)?n:null; }",
    "baseline": "export function parseDuration(...args) { throw new Error(\"Not implemented\"); }",
    "mutants": [
      {
        "name": "boundary-or-contract-regression",
